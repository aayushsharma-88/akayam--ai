# AKAYAM AI Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/akayam_ai"

# ─────────────────────────────────────────────
# AUTHENTICATION (NextAuth v5)
# ─────────────────────────────────────────────
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
# AUTH_GOOGLE_ID="your-google-client-id"
# AUTH_GOOGLE_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────
# AI PROVIDERS — TEXT & VISION
# ─────────────────────────────────────────────
# Gemini
GEMINI_API_KEY="sk-..."

# Google Gemini (text, vision, multimodal)
# GOOGLE_AI_API_KEY="AI..."

# Anthropic Claude
# ANTHROPIC_API_KEY="sk-ant-..."

# ─────────────────────────────────────────────
# AI PROVIDERS — IMAGE GENERATION
# ─────────────────────────────────────────────
# Gemini
# Stability AI
# STABILITY_API_KEY="sk-..."
# Replicate
# REPLICATE_API_TOKEN="r8_..."

# ─────────────────────────────────────────────
# AI PROVIDERS — VIDEO GENERATION
# ─────────────────────────────────────────────
# Runway ML
# RUNWAY_API_KEY="..."
# Replicate (Stable Video Diffusion)
# REPLICATE_API_TOKEN="r8_..."

# ─────────────────────────────────────────────
# AI PROVIDERS — SPEECH
# ─────────────────────────────────────────────
# Gemini
# ElevenLabs TTS
# ELEVENLABS_API_KEY="..."

# ─────────────────────────────────────────────
# FILE STORAGE
# ─────────────────────────────────────────────
# Local storage (development only - set to "local")
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 Compatible (production)
# STORAGE_PROVIDER="s3"
# STORAGE_ENDPOINT="https://s3.amazonaws.com"
# STORAGE_REGION="us-east-1"
# STORAGE_ACCESS_KEY="AKIA..."
# STORAGE_SECRET_KEY="..."
# STORAGE_BUCKET="akayam-ai"
# STORAGE_PUBLIC_URL="https://cdn.yourdomain.com"

# ─────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Akayam AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Max file upload size in bytes (default 50MB)
MAX_UPLOAD_SIZE=52428800

# ─────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────
# Upstash Redis (optional, for production rate limiting)
# UPSTASH_REDIS_REST_URL="..."
# UPSTASH_REDIS_REST_TOKEN="..."
